CONFIG_RISCV_ISA_V=y
CONFIG_SMP=y
CONFIG_NR_CPUS=4
CONFIG_BLK_DEV_INITRD=y
CONFIG_DEVTMPFS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_SYSCTL=y
CONFIG_FUTEX=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_TMPFS=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_OF_PLATFORM=y
CONFIG_RANDOM_TRUST_CPU=y
# NET already provides loopback; NETDEVICES gates SO_BINDTODEVICE. Enabling
# it does not add a NIC; keep physical and virtual device families disabled.
# Disable their parent families explicitly instead of promoting modules.
# CONFIG_MODULES is not set
# CONFIG_DRM is not set
# CONFIG_SOUND is not set
# CONFIG_WLAN is not set
# CONFIG_BT is not set
# CONFIG_USB_SUPPORT is not set
# CONFIG_MEDIA_SUPPORT is not set
# CONFIG_STAGING is not set
# CONFIG_SCSI is not set
# CONFIG_ATA is not set
# CONFIG_NVME_CORE is not set
# CONFIG_BLK_DEV_NVME is not set
# CONFIG_NVME_TARGET is not set
# CONFIG_INFINIBAND is not set
# CONFIG_WIREGUARD is not set
# CONFIG_CAN is not set
# CONFIG_NFC is not set
CONFIG_NETDEVICES=y
# CONFIG_NET_CORE is not set
# CONFIG_ETHERNET is not set
# PCS_XPCS selects PHYLINK, which selects PHYLIB; keep reverse selectors off.
# CONFIG_PCS_XPCS is not set
# CONFIG_PHYLINK is not set
# CONFIG_PHYLIB is not set
# CONFIG_PPP is not set
# CONFIG_SLIP is not set
# CONFIG_WAN is not set
# CONFIG_VIRTIO_NET is not set
# CONFIG_E1000 is not set
# CONFIG_E1000E is not set
# CONFIG_PCNET32 is not set
# CONFIG_8139CP is not set
# CONFIG_8139TOO is not set
# CONFIG_DUMMY is not set
# CONFIG_TUN is not set
# CONFIG_VETH is not set
# CONFIG_BRIDGE is not set
# CONFIG_BONDING is not set
# CONFIG_MACVLAN is not set
# CONFIG_IPVLAN is not set
# CONFIG_VXLAN is not set
